# Configure credentials locally. Real .env files are ignored by Git.
COMFYROUTER_LLM_BASE_URL=https://api.openai.com/v1
COMFYROUTER_LLM_API_KEY=
COMFYROUTER_LLM_MODEL=gpt-6-sol
COMFYROUTER_LLM_ITERATION_MODEL=gpt-6-sol
COMFYROUTER_LLM_EVALUATION_MODEL=gpt-6-sol
COMFYROUTER_LLM_EVALUATION_API_KEY=
COMFYROUTER_LLM_RESULT_PROTOCOL=function_calling
COMFYROUTER_LLM_STREAM=1
COMFYROUTER_LLM_TIMEOUT=180
COMFYROUTER_LLM_CONNECT_TIMEOUT=8
COMFYROUTER_LLM_HEADER_TIMEOUT=90
COMFYROUTER_LLM_PROMPT_CACHE_RETENTION=24h

# Optional proxy; leave these blank for direct external connections.
COMFYROUTER_EXTERNAL_PROXY_URL=
COMFYROUTER_LLM_PROXY_URL=
NO_PROXY=127.0.0.1,localhost,::1

# Defaults are sibling ComfyUI and ComfyBench directories.
# Supply absolute paths for a different deployment.
# COMFYROUTER_COMFYUI_ROOT=/path/to/ComfyUI
# COMFYROUTER_COMFYUI_INPUT_ROOT=/path/to/ComfyUI/input
# COMFYROUTER_COMFYBENCH_ROOT=/path/to/ComfyBench
COMFYROUTER_COMFYUI_API=http://127.0.0.1:8188
COMFYROUTER_API_SERIAL_LOCK=/tmp/comfyrouter-api.serial.lock
COMFYROUTER_COMFYUI_LOCK=/tmp/comfyrouter-comfyui.serial.lock
# Optional external search CLI for structural repair discovery.
# COMFYROUTER_ANYSEARCH_CLI=/path/to/anysearch_cli.py
